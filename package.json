{
  "name": "cria-forma-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cria-forma/web",
    "build": "npm run build -w @cria-forma/web",
    "start": "npm run start -w @cria-forma/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @cria-forma/web",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.7"
  }
}
