# Connection string do Postgres (Neon).
#
# Use a URL *pooled* do Neon (o host com `-pooler`): o adapter `@prisma/adapter-neon`
# foi escolhido justamente para aproveitar o pooler em ambiente serverless.
#
# Nunca commite o .env de verdade — ele está no .gitignore.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/criaforma?sslmode=require"
