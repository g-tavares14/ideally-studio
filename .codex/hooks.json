{
  "description": "Automação de pull requests para commits executados pelo Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/open_pr_after_commit.py\"",
            "timeout": 60,
            "statusMessage": "Criando PR após commit"
          }
        ]
      }
    ]
  }
}
